# Copy to .env (git-ignored) and fill in. Loaded by brain/config.py on start.

# Key for the language model behind Rocky. Which provider it belongs to is
# LLM_BASE_URL in brain/config.py: OpenRouter by default (openrouter.ai/keys),
# or an Anthropic or OpenAI key with that provider's URL and model name.
LLM_API_KEY=
# Optional: Anthropic or OpenAI directly instead of OpenRouter, e.g.
#   LLM_BASE_URL=https://api.anthropic.com/v1/   and   LLM_MODEL=claude-haiku-5-5
# Leave both empty for OpenRouter with Claude Haiku 5.5.
LLM_BASE_URL=
LLM_MODEL=

# fish.audio/app/api-keys — Rocky's voice (optional; falls back to the Mac's voice)
FISH_AUDIO_API_KEY=

# Optional: lets Rocky find and play songs on Spotify by name ("play Mr. Blue Sky").
# developer.spotify.com/dashboard -> Create app (any name; Redirect URI http://127.0.0.1:8766/;
# tick "Web API") -> Settings -> copy the Client ID and Client secret. Spotify only gives
# these keys to Premium accounts. Without them he opens Spotify's search for you to pick.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Which country's catalog to search (two letters). Default US.
SPOTIFY_MARKET=

# Optional: focus mode, where Rocky keeps you off your phone during a focus session
# ("Rocky, help me focus for 25 minutes"). He checks the camera picture with OpenAI's
# Decisions API, about 3 cents a 25-minute session. platform.openai.com/api-keys
# (needs billing set up). Separate from LLM_API_KEY above.
OPENAI_API_KEY=

# What Rocky calls you
HUMAN_NAME=

# Shared secret the robot must present when it connects (also in firmware/include/secrets.h)
ROBOT_TOKEN=

# Optional: which Mac microphone to use when the robot is offline, by name
# (python -m sounddevice lists them). Leave empty for the system default.
# The dashboard's "He listens through" choice overrides this.
MIC_DEVICE=

# Optional: "mac" lets Rocky see through this computer's camera while the server
# runs alone (the robot's camera always wins while it's connected). Leave empty
# for no camera without the robot. The dashboard's Settings > Vision "He sees
# through" choice overrides this. Works on macOS, Windows and Linux; macOS asks
# once for Camera access for the app that runs the server (System Settings >
# Privacy & Security > Camera).
CAMERA_SOURCE=
# Which camera when there is more than one (its number; empty = the default).
CAMERA_LOCAL_INDEX=

# Optional: where the two turn-detection models are cached on first run.
# Default is ~/.cache/desk-robot/ (the speech model goes to ~/.cache/huggingface/).
DESK_ROBOT_CACHE=
