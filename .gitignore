# PlatformIO
firmware/.pio/
firmware/.vscode/

# Python
__pycache__/
*.pyc
server/.venv/
.venv/

# Secrets — never commit WiFi or API credentials
firmware/include/secrets.h
.env
.env.*
!.env.example

# Dashboard settings: personal (your location, your name)
server/settings.json
# Perception models: downloaded on first run (brain/perception.py), pinned and checksummed
server/models/*.task
server/models/rfdetr_*.onnx
server/models/siglip_*

# Face packs made in the dashboard (export one to share it)
server/faces/custom/

# Personalities made in the dashboard (export one to share it)
server/characters/

# macOS and editors
.DS_Store
.vscode/
.idea/

# Logs and audio captures
*.log
*.wav

# Mic debug recordings
server/debug/

# Session file some tools drop at the repo root
:memory:.ses

# Pan/tilt CAD (Fusion archive, STLs, generator): kept locally and in Fusion, not in the repo
docs/cad/

# Codex CLI project config (written by the Fusion MCP add-in)
.codex/

# Custom PCBs (KiCad, Gerbers): sold with the print files, not in the repo
pcb/
